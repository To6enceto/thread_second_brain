{
  "name": "thread-obsidian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local AI project memory and research companion for Obsidian.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "node esbuild.config.mjs --production",
    "verify": "npm run typecheck && npm test && npm run build",
    "package": "npm run verify && node scripts/package.mjs",
    "evaluate": "node --experimental-strip-types scripts/evaluate.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
